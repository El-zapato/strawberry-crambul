[node name="MenuBackground" parent="." instance=ExtResource("2_bg")]
modulate = Color(1, 1, 1, 1)
layout_mode = 0

[node name="Scene" type="TextureRect" parent="."]
modulate = Color(1, 1, 1, 1)
layout_mode = 0
offset_right = 640.0
offset_bottom = 360.0
mouse_filter = 2
texture = ExtResource("3_scene")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 16.0
offset_right = 560.0
offset_bottom = 168.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 24
theme_override_colors/font_outline_color = Color(0.45, 0.12, 0.28, 1)
