[node name="NarrativeLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.12, 0.28, 1)
text = "La Carpintera cruzó el abismo.\nCon sus herramientas y los secretos descubiertos,\nreconstruyó el puente y salvó a todos."
