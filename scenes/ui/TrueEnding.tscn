[ext_resource type="Texture2D" path="res://assets/sprites/ui/true_ending_scene.png" id="3_scene"]

[node name="TrueEnding" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
